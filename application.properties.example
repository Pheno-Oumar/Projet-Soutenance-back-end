# ===================================================================
# Fichier modèle d'exemple pour la configuration Spring Boot
# Copiez ce fichier vers src/main/resources/application.properties
# ===================================================================

spring.application.name=mon-salon

# Base de données MySQL
spring.datasource.url=jdbc:mysql://localhost:3306/mon_salon_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username=root
spring.datasource.password=
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA / Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

server.servlet.context-path=/api/v1/mon-salon

# Configuration JWT & Sécurité
app.jwt.secret=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
app.jwt.expiration-ms=86400000
app.jwt.refresh-expiration-ms=604800000
app.jwt.cookie-name=refreshToken
app.jwt.cookie-secure=false

# Cloudinary
cloudinary.cloud_name=VOTRE_CLOUD_NAME
cloudinary.api_key=VOTRE_CLOUDINARY_API_KEY
cloudinary.api_secret=VOTRE_CLOUDINARY_API_SECRET

# Configuration Multipart
spring.servlet.multipart.enabled=true
spring.servlet.multipart.max-file-size=100MB
spring.servlet.multipart.max-request-size=100MB

# Configuration Assistant Virtuel Gemini
gemini.api-key=VOTRE_GEMINI_API_KEY
gemini.model=gemini-3.8-flash
gemini.base-url=https://generativelanguage.googleapis.com/v1beta
gemini.timeout-ms=15000

# Jackson Deserialization
spring.jackson.deserialization.accept-empty-string-as-null-object=true
